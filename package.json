{
  "name": "pes-simulator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.core.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.browser.json",
    "build": "vite build",
    "dev": "vite",
    "sim-smoke": "tsx src/apps/headless/cli.ts --scenario eval/scenarios/foundation-move-and-roll.v1.json --out artifacts/sim-smoke",
    "replay-verify": "tsx src/apps/headless/replay-verify-cli.ts",
    "eval-compare": "tsx src/apps/headless/eval-compare-cli.ts",
    "gauntlet:eval": "tsx gauntlet/evals/src/run.ts",
    "gauntlet:eval:state": "tsx gauntlet/evals/src/run-state-audit.ts",
    "gauntlet:eval:model": "tsx gauntlet/evals/src/run-model.ts",
    "test": "vitest run --project node",
    "test-browser": "vitest run --project browser",
    "capture-wip": "GAUNTLET_EVIDENCE_CAPTURE=1 WIP_SECTION=__EVIDENCE__:${WIP_SECTION:-capture} WIP_FRAMES=${WIP_FRAMES:-1} vitest run tests/browser/capture-wip.browser.test.ts --project browser",
    "test-all": "CI=1 pnpm install --frozen-lockfile && CI=1 pnpm run gauntlet:eval && CI=1 pnpm run typecheck && CI=1 pnpm run test && CI=1 pnpm run test-browser && CI=1 pnpm run sim-smoke && pnpm run build",
    "capture-ai-trajectory": "tsx scripts/capture-ai-match-trajectory.ts",
    "capture-5v5-anti-huddle-evidence": "tsx scripts/capture-5v5-kickoff-anti-huddle-evidence.ts",
    "capture-restart-anti-huddle-evidence": "tsx scripts/capture-restart-anti-huddle-evidence.ts",
    "capture-gk-5v5-adapter-behavior": "tsx scripts/capture-gk-5v5-adapter-behavior-evidence.ts",
    "capture-cpu-tackle-evidence": "tsx scripts/capture-cpu-defensive-tackle-evidence.ts",
    "capture-cpu-tackle-frames": "WIP_SECTION=__EVIDENCE__:CPU-DEFENSIVE-TACKLE vitest run tests/browser/cpu-tackle-screenshot-capture.browser.test.ts --project browser",
    "capture-5v5-anti-huddle-frames": "WIP_SECTION=__EVIDENCE__:BROWSER-5V5-ANTI-HUDDLE-DYNAMIC-EVIDENCE vitest run tests/browser/anti-huddle-dynamic-evidence.browser.test.ts --project browser",
    "capture-human-vs-cpu-arc-frames": "WIP_SECTION=__EVIDENCE__:HUMAN-VS-CPU-ARC-INTERACTION vitest run tests/browser/human-arc-interaction.browser.test.ts --project browser",
    "capture-gk-browser-dynamic-evidence": "WIP_SECTION=__EVIDENCE__:GK-BROWSER-DYNAMIC-EVIDENCE vitest run tests/browser/gk-browser-dynamic-evidence.browser.test.ts --project browser",
    "capture-ai-video": "node scripts/capture-ai-match-video.mjs",
    "capture-controls-legend": "node scripts/capture-controls-legend-screenshots.mjs",
    "gauntlet:audit": "tsx gauntlet/evals/src/gauntlet-audit.ts",
    "gauntlet:acceptance:persist": "tsx gauntlet/evals/src/persist-acceptance.ts",
    "gauntlet:acceptance:durability": "node scripts/ci/verify-acceptance-durability.mjs",
    "gauntlet:verify-gk-stash": "node scripts/ci/verify-gk-stash-identity-head.mjs",
    "gauntlet:video:reference": "tsx gauntlet/evals/src/write-video-reference.ts",
    "gauntlet:milestone:bundle": "tsx gauntlet/evals/src/build-milestone-bundle.ts",
    "gauntlet:milestone:evaluate": "tsx gauntlet/evals/src/evaluate-milestone-playtest.ts",
    "gauntlet:candidate-scope": "node scripts/ci/verify-candidate-scope.mjs"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "vite": "^6.3.5",
    "vitest": "^3.1.1",
    "@vitest/browser": "^3.1.1",
    "playwright": "^1.51.0",
    "tsx": "^4.19.3",
    "@types/three": "^0.174.0",
    "@types/node": "^22.13.10"
  }
}
