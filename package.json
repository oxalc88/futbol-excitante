{
  "name": "futbol-excitante",
  "version": "1.0.0-rebuild.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && FE_BUILD_LAB=0 vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "evaluate": "node --import tsx scripts/evaluate.ts",
    "reference:import": "node --import tsx scripts/import-reference.ts",
    "evaluate:traces": "node --import tsx scripts/evaluate.ts --traces",
    "timing:compare": "node --import tsx scripts/measure-game-timing.ts",
    "timing:c7": "node --import tsx scripts/measure-c7-movement.ts",
    "build:lab": "tsc --noEmit && FE_BUILD_LAB=1 vite build",
    "check:dist": "node scripts/check-dist.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "@types/three": "0.180.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.1.6"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
