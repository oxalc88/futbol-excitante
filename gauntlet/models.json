{
  "version": "gauntlet-models-v2",
  "notes": "Grok agent frontmatter model fields and ~/.grok/config.toml [subagents.models] must stay in sync with this file. NaN endpoints are registered in ~/.grok/config.toml (user-level). Quote dotted keys as [model.\"qwen3.6\"]. See gauntlet/README.md.",
  "roles": {
    "orchestrator": {
      "agent": "orchestrator",
      "mode": "primary",
      "provider": "xai",
      "model": "grok-4.6",
      "fallback": ["grok-4.6"]
    },
    "builder_qwen": {
      "agent": "builder-qwen",
      "mode": "subagent",
      "provider": "nan",
      "model": "qwen3.6",
      "api_model": "qwen3.6",
      "fallback": ["mimo-v2.5"]
    },
    "builder_mimo": {
      "agent": "builder-mimo",
      "mode": "subagent",
      "provider": "nan",
      "model": "mimo-v2.5",
      "api_model": "mimo-v2.5",
      "fallback": ["qwen3.6"]
    },
    "critic": {
      "agent": "critic",
      "mode": "subagent",
      "provider": "nan",
      "model": "deepseek-v4-flash-0731",
      "api_model": "deepseek-v4-flash-0731",
      "fallback": ["critic-qwen", "critic-mimo"],
      "constraint": "Never use the same model that implemented the candidate under review."
    },
    "critic_qwen": {
      "agent": "critic-qwen",
      "mode": "subagent",
      "hidden": true,
      "provider": "nan",
      "model": "qwen3.6",
      "api_model": "qwen3.6"
    },
    "critic_mimo": {
      "agent": "critic-mimo",
      "mode": "subagent",
      "hidden": true,
      "provider": "nan",
      "model": "mimo-v2.5",
      "api_model": "mimo-v2.5"
    },
    "integration_reviewer": {
      "agent": "integration-reviewer",
      "mode": "subagent",
      "provider": "nan",
      "model": "deepseek-v4-flash-0731",
      "api_model": "deepseek-v4-flash-0731",
      "fallback": ["qwen3.6", "mimo-v2.5"],
      "constraint": "Prefer DeepSeek. If unavailable, use a NaN model different from the builder under review."
    },
    "aux": {
      "agent": "aux",
      "mode": "subagent",
      "provider": "nan",
      "model": "gemma4",
      "api_model": "gemma4",
      "fallback": ["qwen3.6"]
    },
    "git_committer": {
      "agent": "git-committer",
      "mode": "subagent",
      "provider": "nan",
      "model": "gemma4",
      "api_model": "gemma4",
      "fallback": ["qwen3.6"],
      "constraint": "Bookkeeping only. Never inherit grok-4.6. Never implement or review."
    }
  },
  "cheap_auxiliary": ["gemma4", "qwen3.6"],
  "high_volume": ["qwen3.6", "mimo-v2.5", "deepseek-v4-flash-0731", "gemma4"],
  "grok_uses": [
    "orchestration",
    "prioritization",
    "delegation",
    "integration decisions",
    "next-objective selection"
  ],
  "grok_never": [
    "implementation",
    "test fixing",
    "parameter experimentation",
    "routine criticism",
    "narrow unblocker after NaN failures",
    "git commit",
    "git push"
  ]
}
