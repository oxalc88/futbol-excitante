{
  "version": "gauntlet-models-v2",
  "notes": "Grok agent frontmatter model fields and ~/.grok/config.toml [subagents.models] must stay in sync with this file. NaN endpoints are registered in ~/.grok/config.toml (user-level). Quote dotted keys as [model.\"qwen3.6\"]. See gauntlet/README.md.",
  "roles": {
    "orchestrator": {
      "agent": "orchestrator",
      "mode": "primary",
      "provider": "xai",
      "model": "grok-4.6",
      "fallback": ["orchestrator-deepseek"],
      "handoff_at_percent": 89,
      "handoff_metric": "super_grok_weekly_usage",
      "auto_compact_percent": 65
    },
    "orchestrator_deepseek": {
      "agent": "orchestrator-deepseek",
      "mode": "primary",
      "provider": "nan",
      "model": "deepseek-v4-flash",
      "api_model": "deepseek-v4-flash",
      "reasoning_effort": "high",
      "fallback": ["deepseek-v4-flash-0731"],
      "constraint": "Overflow pickup only. Same loop as orchestrator. Critic independence is versus the builder, not this agent. Keep timing output separated by exact model ID and role; never combine current Flash with the 0731 snapshot."
    },
    "builder_qwen": {
      "agent": "builder-qwen",
      "mode": "subagent",
      "provider": "nan",
      "model": "qwen3.6",
      "api_model": "qwen3.6",
      "fallback": ["mimo-v2.5"]
    },
    "builder_mimo": {
      "agent": "builder-mimo",
      "mode": "subagent",
      "provider": "nan",
      "model": "mimo-v2.5",
      "api_model": "mimo-v2.5",
      "fallback": ["qwen3.6"]
    },
    "critic": {
      "agent": "critic",
      "mode": "subagent",
      "provider": "nan",
      "model": "deepseek-v4-flash-0731",
      "api_model": "deepseek-v4-flash-0731",
      "fallback": ["deepseek-v4-flash", "critic-qwen", "critic-mimo"],
      "constraint": "Never use the same model that implemented the candidate under review."
    },
    "critic_qwen": {
      "agent": "critic-qwen",
      "mode": "subagent",
      "hidden": true,
      "provider": "nan",
      "model": "qwen3.6",
      "api_model": "qwen3.6"
    },
    "critic_mimo": {
      "agent": "critic-mimo",
      "mode": "subagent",
      "hidden": true,
      "provider": "nan",
      "model": "mimo-v2.5",
      "api_model": "mimo-v2.5"
    },
    "integration_reviewer": {
      "agent": "integration-reviewer",
      "mode": "subagent",
      "provider": "nan",
      "model": "deepseek-v4-flash-0731",
      "api_model": "deepseek-v4-flash-0731",
      "fallback": ["deepseek-v4-flash", "qwen3.6", "mimo-v2.5"],
      "constraint": "Prefer DeepSeek. If unavailable, use a NaN model different from the builder under review."
    },
    "aux": {
      "agent": "aux",
      "mode": "subagent",
      "provider": "nan",
      "model": "gemma4",
      "api_model": "gemma4",
      "fallback": ["qwen3.6"]
    },
    "git_committer": {
      "agent": "git-committer",
      "mode": "subagent",
      "provider": "nan",
      "model": "gemma4",
      "api_model": "gemma4",
      "fallback": ["qwen3.6"],
      "constraint": "Bookkeeping only. Never inherit grok-4.6. Never implement or review."
    }
  },
  "cheap_auxiliary": ["gemma4", "qwen3.6"],
  "high_volume": ["qwen3.6", "mimo-v2.5", "deepseek-v4-flash-0731", "deepseek-v4-flash", "gemma4"],
  "grok_uses": [
    "orchestration until SuperGrok weekly usage hits 89%",
    "prioritization",
    "delegation",
    "integration decisions",
    "next-objective selection",
    "writing HANDOFF.md"
  ],
  "grok_never": [
    "implementation",
    "test fixing",
    "parameter experimentation",
    "routine criticism",
    "narrow unblocker after NaN failures",
    "git commit",
    "git push"
  ]
}
