{
  "version": "gauntlet-models-v6",
  "notes": "Role names describe responsibilities; model selection is routing. Keep this file aligned with the agent model declarations used by the Gauntlet. See gauntlet/README.md.",
  "roles": {
    "orchestrator": {
      "agent": "orchestrator",
      "mode": "primary",
      "provider": "xai",
      "model": "grok-4.6",
      "fallback": [
        "orchestrator-deepseek"
      ],
      "handoff_at_percent": 89,
      "handoff_metric": "super_grok_weekly_usage",
      "auto_compact_percent": 65
    },
    "orchestrator_deepseek": {
      "agent": "orchestrator-deepseek",
      "mode": "primary",
      "provider": "nan",
      "model": "deepseek-v4-flash",
      "api_model": "deepseek-v4-flash",
      "reasoning_effort": "high",
      "fallback": [],
      "constraint": "Overflow pickup only. Same canonical orchestrator contract with runtime-specific pickup semantics. Critic independence is versus the builder, not this agent. Keep timing output separated by exact model ID and role."
    },
    "builder_structured": {
      "agent": "builder-structured",
      "role_contract": "gauntlet/roles/builder-structured.md",
      "mode": "subagent",
      "provider": "nan",
      "model": "qwen3.6",
      "api_model": "qwen3.6"
    },
    "builder_gameplay": {
      "agent": "builder-gameplay",
      "role_contract": "gauntlet/roles/builder-gameplay.md",
      "mode": "subagent",
      "provider": "nan",
      "model": "mimo-v2.5",
      "api_model": "mimo-v2.5"
    },
    "critic": {
      "agent": "critic",
      "role_contract": "gauntlet/roles/critic.md",
      "mode": "subagent",
      "provider": "nan",
      "model": "deepseek-v4-flash",
      "api_model": "deepseek-v4-flash",
      "fallback": [
        "critic-qwen",
        "critic-mimo"
      ],
      "constraint": "Primary DeepSeek critic. Never use the same model that implemented the candidate under review. On model-specific unavailability/capability failure, reroute to an independent Qwen/MiMo critic rather than overriding the agent model in place."
    },
    "critic_qwen": {
      "agent": "critic-qwen",
      "role_contract": "gauntlet/roles/critic.md",
      "mode": "subagent",
      "provider": "nan",
      "hidden": true,
      "model": "qwen3.6",
      "api_model": "qwen3.6"
    },
    "critic_mimo": {
      "agent": "critic-mimo",
      "role_contract": "gauntlet/roles/critic.md",
      "mode": "subagent",
      "provider": "nan",
      "hidden": true,
      "model": "mimo-v2.5",
      "api_model": "mimo-v2.5"
    },
    "integration_reviewer": {
      "agent": "integration-reviewer",
      "role_contract": "gauntlet/roles/integration-reviewer.md",
      "mode": "subagent",
      "provider": "nan",
      "model": "deepseek-v4-flash",
      "api_model": "deepseek-v4-flash",
      "fallback": [
        "qwen3.6",
        "mimo-v2.5"
      ],
      "constraint": "Primary DeepSeek integration reviewer. On model-specific unavailability/capability failure, use a NaN model different from the builder under review."
    },
    "aux": {
      "agent": "aux",
      "mode": "subagent",
      "provider": "nan",
      "model": "gemma4",
      "api_model": "gemma4",
      "fallback": [
        "qwen3.6"
      ]
    },
    "git_committer": {
      "agent": "git-committer",
      "mode": "subagent",
      "provider": "nan",
      "model": "gemma4",
      "api_model": "gemma4",
      "fallback": [
        "qwen3.6"
      ],
      "constraint": "Bookkeeping only. Never inherit grok-4.6. Never implement or review."
    },
    "evidence_auditor": {
      "agent": "aux",
      "mode": "subagent",
      "provider": "nan",
      "model": "gemma4",
      "api_model": "gemma4",
      "fallback": [
        "qwen3.6"
      ],
      "constraint": "Bounded semantic audit only after deterministic REVIEW_REQUIRED. Never judges overall reference-bar quality and never accepts an objective."
    }
  },
  "cheap_auxiliary": [
    "gemma4",
    "qwen3.6"
  ],
  "high_volume": [
    "qwen3.6",
    "mimo-v2.5",
    "deepseek-v4-flash",
    "gemma4"
  ],
  "grok_uses": [
    "orchestration until SuperGrok weekly usage hits 89%",
    "prioritization",
    "delegation",
    "integration decisions",
    "next-objective selection",
    "writing HANDOFF.md"
  ],
  "grok_never": [
    "implementation",
    "test fixing",
    "parameter experimentation",
    "routine criticism",
    "narrow unblocker after NaN failures",
    "git commit",
    "git push"
  ]
}
